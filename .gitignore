node_modules/
__pycache__/
*.pyc

# 訓練產物：binary，而且 python ml/train.py 就能重跑出來。
ml/checkpoints/*.pt
ml/checkpoints/*.log

# goal2 的分段快取（每段一個檔，用來中斷續跑）。
# 彙總後的 goal2.json 有進版控——圖文版、README、影片描述都讀它。
ml/checkpoints/goal2-*.json

# 兩張精確距離表：2x2x2 全狀態（33 MB，python ml/bfs.py 花 18 秒）
# 與 3x3x3 的角塊（88 MB，python ml/corners.py 花 114 秒）。
# 都是驗證用的正確答案，不該進版控——要驗就自己算一次。
ml/checkpoints/dist222.npz
ml/checkpoints/corners3.npy

# 網頁要用的權重。兩份都進版控：checkpoint 本身沒進版控，
# 所以不放這個的話，clone 下來的人得先訓練 2.5 小時才看得到 3x3x3 那一頁。
# （2x2x2 3.5 MB、3x3x3 22 MB。4 位小數是必要的——3 位的誤差 0.048 步，太大。）

# 對帳用的臨時題目（python ml/export_corner_tables.py 之後自己產）
web/_corner_cases.json

# 影片與 artifact 的建置產物（mp4、旁白 mp3、預覽 png、artifact.html）。
# 影片在 YouTube 上，artifact 在 claude.ai 上，這裡不需要再存一份。
out/*
!out/plan.json
!out/plan2.json
!out/youtube.json
!out/youtube2.json
!out/artifact1.json
